{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2017", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@bella/api/adapters": ["libs/api/adapters/src/index.ts"],
      "@bella/api/domain": ["libs/api/domain/src/index.ts"],
      "@bella/dtos": ["libs/dtos/src/index.ts"],
      "swiper/angular": ["node_modules/swiper/angular/swiper_angular.d.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
