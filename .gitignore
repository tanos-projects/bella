# See http://help.github.com/ignore-files/ for more about ignoring files.

# compiled output
/dist
/tmp
/out-tsc

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.angular
/amplify

# secrets — .env.dist is the committed template, .env itself never is.
# The API reads a .env at the repository root, which only /apps/**/.env
# covered before, so a root .env would have been committed.
.env
.env.*
!.env.dist
/apps/**/.env
# Exception: apps/api/.env.test carries no secret, only a scoped
# NODE_OPTIONS for `nx test api` (CHANTIER-MODERNISATION.md §4, Phase
# 0bis, §7 point 5) - Nx loads project+target-scoped .env.<target> files
# automatically per task, so this only ever reaches api's own test task.
!/apps/api/.env.test

# Nx local cache and daemon/workspace state (Nx 19+ adds workspace-data
# alongside cache — none of .nx/ is meant to be committed)
/.nx

# git worktrees for parallel feature work — nested under the repo root so
# Nx's project globbing must not see them, or every project collides with
# its own copy inside each worktree ("multiple projects named X" errors)
/.worktrees
